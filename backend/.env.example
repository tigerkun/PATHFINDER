GITHUB_TOKEN=replace-with-github-token
GEMINI_API_KEY=replace-with-gemini-key
API_AUTH_KEY=replace-with-strong-random-key-min-16-chars
API_AUTH_MIN_LENGTH=16
AUTH_MODE=hybrid
JWT_SECRET_KEY=replace-with-strong-jwt-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=

# Comma-separated frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security and deployment hardening
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false
ENABLE_HTTPS_REDIRECT=false
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'

# Runtime controls
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=3600
JOB_DB_PATH=jobs.db
DATA_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JOBS_TABLE=jobs
SUPABASE_PREDICTIONS_TABLE=predictions
QUEUE_BACKEND=inprocess
